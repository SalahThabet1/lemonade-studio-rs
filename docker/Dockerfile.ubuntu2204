# Portable release build for Lemonade Studio.
# Baseline: Ubuntu 22.04 (glibc 2.35) so the binary + AppImage run on
# Ubuntu 22.04+, Debian 12+, Fedora 38+, Arch, and other modern x86_64 distros.
# An Arch-built binary requires glibc 2.44 and will NOT run on those systems.
#
# Usage:
#   docker build -f docker/Dockerfile.ubuntu2204 -t lemonade-builder .
#   docker run --rm -v "$PWD/build:/out" \
#     -v lemonade-cargo:/usr/local/cargo lemonade-builder \
#     bash -c "cp /src/target/release/lemonade-studio-rs /out/"
#
# The cargo registry lives in a named volume so rebuilds don't re-download crates.

FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive \
    RUSTUP_HOME=/usr/local/rustup \
    CARGO_HOME=/usr/local/cargo \
    PATH=/usr/local/cargo/bin:$PATH

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    ca-certificates \
    curl \
    pkg-config \
    cmake \
    git \
    libssl-dev \
    libx11-dev \
    libxcb1-dev \
    libxkbcommon-dev \
    libxkbcommon-x11-dev \
    libgl1-mesa-dev \
    libegl1-mesa-dev \
    libwayland-dev \
    libfontconfig1-dev \
    && rm -rf /var/lib/apt/lists/*

RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs \
    | sh -s -- -y --profile minimal --default-toolchain stable \
    && rustc --version && cargo --version

WORKDIR /src
COPY . /src/

# Exclude host target dir from the build context via .dockerignore;
# build fresh inside the container for the old-glibc baseline.
RUN cargo build --release --locked
